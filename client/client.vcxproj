    <ClInclude Include="$(RefactoredDir)common\input_types.hpp" />
    <ClInclude Include="$(RefactoredDir)common\logger.hpp" />
    <ClInclude Include="$(RefactoredDir)common\message.hpp" />
    <ClInclude Include="$(RefactoredDir)common\proto_codec.hpp" />
    <ClInclude Include="$(RefactoredDir)common\trace.hpp" />
    <ClInclude Include="$(RefactoredDir)common\tls.hpp" />
    <ClInclude Include="$(RefactoredDir)common\win_raii.hpp" />
    <ClInclude Include="$(RefactoredDir)proto\generated\rc_protocol_generated.h" />
    <ClInclude Include="$(RefactoredDir)client\async_client.hpp" />
    <ClInclude Include="$(RefactoredDir)client\remote_window.hpp" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
