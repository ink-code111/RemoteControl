    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros">
    <RefactoredDir>$(MSBuildThisFileDirectory)..\refactored\</RefactoredDir>
    <OutDir>$(MSBuildThisFileDirectory)..\bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\bin\$(Platform)\$(Configuration)\obj\$(ProjectName)\</IntDir>
    <TargetName>rc_client</TargetName>
    <!-- F5 调试时的工作目录设为输出目录：程序按相对路径读取 config/client.json，
         输出目录下的 config/ 由构建后事件复制（两个工程输出同一目录） -->
    <LocalDebuggerWorkingDirectory>$(OutDir)</LocalDebuggerWorkingDirectory>
    <DebuggerFlavor>WindowsLocalDebugger</DebuggerFlavor>
    <!-- 公共包含路径：业务头、协议生成代码、四个第三方依赖 -->
    <RcCommonIncludes>$(RefactoredDir)common;$(RefactoredDir)client;$(RefactoredDir)proto\generated;$(RefactoredDir)third_party\spdlog\include;$(RefactoredDir)third_party\json\include;$(RefactoredDir)third_party\asio\include;$(RefactoredDir)third_party\flatbuffers\include;$(RefactoredDir)third_party\openssl\include</RcCommonIncludes>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <Optimization>Disabled</Optimization>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>_DEBUG;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;ASIO_STANDALONE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RcCommonIncludes);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(RefactoredDir)third_party\openssl\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ws2_32.lib;mswsock.lib;user32.lib;gdi32.lib;gdiplus.lib;libssl.lib;libcrypto.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
    <PostBuildEvent>
      <Command>if not exist "$(OutDir)config" mkdir "$(OutDir)config"
xcopy /Y /I /E "$(RefactoredDir)config\*" "$(OutDir)config\" &gt;nul
xcopy /Y /I "$(RefactoredDir)third_party\openssl\bin\libssl-3-x64.dll" "$(OutDir)" &gt;nul
xcopy /Y /I "$(RefactoredDir)third_party\openssl\bin\libcrypto-3-x64.dll" "$(OutDir)" &gt;nul</Command>
      <Message>复制运行期配置 config/*.json 与 OpenSSL 运行库 DLL 到输出目录</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level4</WarningLevel>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <SDLCheck>true</SDLCheck>
      <Optimization>MaxSpeed</Optimization>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>NDEBUG;_WINDOWS;WIN32_LEAN_AND_MEAN;NOMINMAX;UNICODE;_UNICODE;ASIO_STANDALONE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(RcCommonIncludes);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalLibraryDirectories>$(RefactoredDir)third_party\openssl\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>ws2_32.lib;mswsock.lib;user32.lib;gdi32.lib;gdiplus.lib;libssl.lib;libcrypto.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
    <PostBuildEvent>
      <Command>if not exist "$(OutDir)config" mkdir "$(OutDir)config"
xcopy /Y /I /E "$(RefactoredDir)config\*" "$(OutDir)config\" &gt;nul
xcopy /Y /I "$(RefactoredDir)third_party\openssl\bin\libssl-3-x64.dll" "$(OutDir)" &gt;nul
xcopy /Y /I "$(RefactoredDir)third_party\openssl\bin\libcrypto-3-x64.dll" "$(OutDir)" &gt;nul</Command>
      <Message>复制运行期配置 config/*.json 与 OpenSSL 运行库 DLL 到输出目录</Message>
    </PostBuildEvent>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(RefactoredDir)client\main.cpp" />
    <ClCompile Include="$(RefactoredDir)client\async_client.cpp" />
    <ClCompile Include="$(RefactoredDir)client\remote_window.cpp" />
    <ClCompile Include="$(RefactoredDir)common\frame.cpp" />
    <ClCompile Include="$(RefactoredDir)common\proto_codec.cpp" />
