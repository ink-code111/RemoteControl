<?xml version="1.0" encoding="utf-8"?>
<!--
  ============================================================
  客户端工程（rc_client）· 第二阶段：异步网络
  ============================================================
  与第一阶段的区别：
    1. 源文件换成异步版：
         async_client.*   替换 network_client.* + screen_receiver.*
                          （阻塞收发线程 → Asio 异步读循环 + 心跳 + 指数退避重连）
         remote_window.*  不再持有网络线程，改为接收回调
         main.cpp         先建窗口再启动客户端
       common 下新增 frame.cpp / proto_codec.cpp（帧头切流 + FlatBuffers 编解码），
       它们与服务端共用同一份实现，避免"两份协议代码略有差异"的老问题。
    2. 新增依赖：standalone Asio（头文件）与 FlatBuffers（头文件 + 生成代码）。
       必须定义 ASIO_STANDALONE，否则 Asio 会去找 Boost 而编译失败。
    3. proto\generated 下是 flatc 生成的协议代码，已入库；改协议时
       用 tools/gen_proto.py 重新生成即可，构建过程不需要 codegen 工具。
    4. 运行期仍从 config/client.json 读取地址/端口等参数（输出目录下的
       config 由构建后事件复制）。
  ============================================================
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
