// ============================================================================
//  rc_protocol.fbs —— 远程控制协议 v2（FlatBuffers schema）
//
//  设计要点（与旧版手写 PacketHeader + #pragma pack 的对比）：
//
//  1) 【为什么用 FlatBuffers 而不是 Protobuf】
//     - FlatBuffers 读取是真·零拷贝：不需要先解析再分配对象，直接按偏移读字段，
//       大块的屏幕帧字节可以直接指向网络缓冲区（第三阶段的"零拷贝优化"就靠它）。
//     - runtime 是纯头文件，schema 生成的代码入库即可，构建期不依赖 codegen 工具。
//     - 本次环境下 Protobuf 需要从源码构建 libprotobuf(+abseil)，代价与风险都更高。
//
//  2) 【为什么 FlatBuffers 不能替代帧头】
//     FlatBuffers 是"序列化格式"，不是"分帧协议"——它不会告诉你一条消息到哪里结束。
//     TCP 是字节流，粘包/半包问题依旧存在。所以仍需要 8 字节定长帧头（见 common/frame.hpp）：
//         [magic u16][version u8][flags u8][payload_len u32]  +  [FlatBuffers Envelope]
//     帧头负责「切流」，FlatBuffers 负责「解包」，两者职责不重叠。
//
//  3) 【向后兼容规则（必须遵守，否则老客户端会崩）】
//     - 只能「追加」字段，且必须用比现有更大的 id；绝不改字段类型、不改字段名含义。
//     - 删除字段用 (deprecated)，保留 id 不再复用。
//     - 枚举值只能追加，不能重排；读到未知枚举值要走 default 分支而不是断言失败。
//     - 只有破坏性变更才允许升 major（帧头 version 字段），服务端按 major 决定是否拒绝。
//     - union 新增成员会让旧端读到未知类型：接收侧必须能容忍并忽略未知 body。
//
//  4) 【安全】接收侧必须先跑 flatbuffers::Verifier（见 VerifyEnvelopeBuffer）再取字段。
//     直接信任不可信输入里的偏移量 → 越界读 → 信息泄露/崩溃。这是协议层的第一个安全边界。
// ============================================================================

namespace rc.proto.v2;

// ---------------------------------------------------------------------------
// 握手 / 会话控制
// ---------------------------------------------------------------------------

/// 客户端首包：声明协议版本与身份。
/// 服务端必须先校验 major 版本一致才进入正常工作流（版本协商）。
table Hello {
    /// 协议主版本号（帧头里也有一份，这里冗余一份便于日志与拒绝理由）
    protocol_version:uint16;
    /// 客户端名称/机器名，仅用于服务端日志与多客户端会话区分
    client_name:string;
    client_version:string;
    /// 【2B 认证】共享密钥。空串 / 缺省 = 未提供凭据。
    ///
    /// 服务端**是否要求**它由服务端配置 `auth_token` 决定（配空 = 不启用认证，
    /// 行为与本字段存在之前逐字一致）。所以这是**纯追加**字段：
    /// 老客户端不发它 → 服务端读到空串 → 在未启用认证时完全等价，不会破坏兼容。
    ///
    /// ⚠️ 本字段当前走**明文传输**（TLS 是 2B 的第二刀）。它解决的是
    /// "谁能连上这个端口"，**不是**"链路上看不看得见凭据"。别把这两件事混为一谈。
    auth_token:string;
}

/// 【2B 第三刀 权限模型】会话的角色 —— 服务端**授权**给这个会话的权限级别。
///
/// 为什么由服务端在 HelloAck 里下发，而不是客户端自己声明：
///   客户端声明的是"我是谁"（凭据），**权限必须由服务端根据凭据查表得出** ——
///   让被授权方自己报权限，等于把授权这件事交给它。所以 Hello.client_name 只是
///   日志用的提示，真正的身份是服务端从 auth_clients 表里查出来的那一条。
///
/// 为什么需要客户端**知道**自己的角色：两个理由，缺一不可 ——
///   ① **可见性**（本项目纪律「降级必须显式可见」）：只读会话必须在标题栏看得出来，
///      否则用户会以为"输入坏了"而反复点；客户端不显示 = 一个静默降级。
///   ② **省带宽**：知道自己是只读就没必要把鼠标/键盘发上去再被拒。
///   ⚠️ 但 ② **不是安全边界** —— 客户端自律是"别浪费"，服务端拦截才是"不许"。
///      判据必须能分开证明这两件事（见 tests/run_audit_check.py 的 debug_ignore_role）。
enum Role : byte {
    /// 可注入鼠标/键盘（默认值 = 0 ⇒ 老服务端不下发时客户端读到 0 就是全权，
    /// 与引入本字段之前的行为一致）
    Control = 0,
    /// 只读：能看到画面，输入被服务端**拒绝**
    View = 1
}

/// 服务端对 Hello 的应答。
table HelloAck {
    protocol_version:uint16;
    /// 会话 id：多客户端场景下用于日志追踪与（后续）定向推流
    session_id:uint32;
    server_time_ms:int64;
    accepted:bool;
    /// accepted=false 时必填，供客户端日志与用户提示
    reject_reason:string;
    /// 【2B 第三刀 权限模型】本会话被授予的角色（追加字段，id 最大）。
    ///
    /// 老客户端读不到这个字段 ⇒ 拿到默认值 `Control`(=0) ⇒ 完全等价于本字段存在之前。
    /// 这是**刻意选的默认值方向**：老客户端不会被一个新字段意外降级成只读。
    role:Role;
}

/// 心跳请求（客户端定时发送）。
table Ping {
    /// 序号：用于配对 Pong，并可估算丢包
    seq:uint32;
    client_time_ms:int64;
}

/// 心跳应答（服务端立即回）。
table Pong {
    seq:uint32;
    /// 原样回带，客户端据此算 RTT
    client_time_ms:int64;
    server_time_ms:int64;
}

// ---------------------------------------------------------------------------
// 输入面（业务逻辑与旧版一致：鼠标移动节流、左/右/中键、双击、键盘 0/1 语义）
// ---------------------------------------------------------------------------

/// 与旧版 MouseAction 枚举取值保持一致，避免重写注入逻辑。
enum MouseAction : byte {
    Move = 0,
    LDown = 1,
    LUp = 2,
    RDown = 3,
    RUp = 4,
    MDown = 5,
    MUp = 6,
    LDClick = 7,
    RDClick = 8,
    MDClick = 9,
    /// 预留：滚轮（旧版没有，帧头版本不变、纯追加，老客户端不受影响）
    Wheel = 10
}

table MouseEvent {
    action:MouseAction;
    /// 已由客户端按远端分辨率映射好的绝对坐标
    x:int32;
    y:int32;
    /// 仅 Wheel 使用（正=上滚，负=下滚），其余动作忽略
    wheel_delta:int32;
}

table KeyboardEvent {
    /// Windows 虚拟键码
    vk:int32;
    /// 与旧版语义一致：true=抬起(KEYUP)，false=按下(KEYDOWN)
    up:bool;
}

// ---------------------------------------------------------------------------
// 屏幕面（第二阶段仍是「请求-应答拉屏」，与旧版行为一致；第三阶段改差异帧推流）
// ---------------------------------------------------------------------------

enum ImageFormat : byte {
    Png = 0,
    /// 预留给第三阶段的 libjpeg-turbo / H.264
    Jpeg = 1,
    H264 = 2
}

/// 脏矩形：第三阶段启用，现在传空数组即可（老端读不到字段就用默认空）
struct Rect {
    x:int32;
    y:int32;
    w:int32;
    h:int32;
}

/// 客户端请求一帧。
table ScreenRequest {
    /// 期望的最大宽度（0=不限制）。第三阶段用于下行带宽自适应。
    max_width:int32;
    /// 期望质量（0=默认）。第二阶段的 PNG 编码忽略此值，仅透传。
    quality:int32;
}

/// 服务端回一帧。
table ScreenFrame {
    width:int32;
    height:int32;
    timestamp_ms:int64;
    format:ImageFormat;
    /// 编码后的图像字节。零拷贝读取：直接用 GetData() 指针，不产生副本。
    data:[ubyte];
    /// 脏矩形列表（第三阶段使用）
    dirty_rects:[Rect];
    /// 【输入→显示延迟】本帧的像素**开始采集之前**，服务端已经应用过的输入事件累计数。
    ///
    /// 语义是**下界**，客户端据此把"自己发出的第 k 次输入"与该输入首次可见的那一帧配对：
    /// 凡是带 input_epoch >= k 的帧，其像素必然采集于第 k 次输入**之后**。
    ///
    /// 为什么不在输入消息里带序号：TCP 保序不丢，客户端"发出第 k 次"与服务端
    /// "应用第 k 次"天然是同一个整数序列，不需要在线上多传一个字段。
    ///
    /// 为什么客户端能靠它算出端到端延迟而不需要时钟同步：客户端只需知道
    /// "我什么时候发的"（自己的时钟）与"这一帧什么时候被我画到窗口上"（同一个时钟），
    /// 序号只负责把两者对上；跨进程比较绝对时刻这件事被完全绕开了。
    ///
    /// 追加字段（id 最大），老客户端读不到会拿到默认 0 = "没有输入观测"，行为不变。
    input_epoch:int64;
}

// ---------------------------------------------------------------------------
// 统一信封
//
// 为什么用一个 union 信封而不是「一个 cmd 枚举 + 裸字节」：
//   - 类型安全：接收侧按 union 实际类型分派，不依赖手写 cmd 常量与结构体对齐约定；
//   - 可演进：新增消息类型只需往 union 追加，老端读到未知类型会得到 NONE 并安全忽略；
//   - 自描述：配合 Verifier，可以在不解析业务字段的前提下完成整包合法性校验。
// ---------------------------------------------------------------------------

union Body {
    Hello,
    HelloAck,
    Ping,
    Pong,
    MouseEvent,
    KeyboardEvent,
    ScreenRequest,
    ScreenFrame
}

table Envelope {
    body:Body;
}

root_type Envelope;

/// 文件标识：写进 buffer 头部，配合 Verifier 能第一时间识别"这不是一个 Envelope"
file_identifier "RCEN";
